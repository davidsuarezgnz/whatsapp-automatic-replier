# Configuración del Bot de WhatsApp

# ID del grupo específico (opcional)
# Si está vacío, funcionará en todos los grupos
# TARGET_GROUP_ID=123456789@c.us

# Control del bot
BOT_ACTIVE=true
BOT_RESPONSE_MESSAGE=YO

# Comandos discretos (opcional)
# true = habilitados, false = deshabilitados
ENABLE_COMMANDS=false 